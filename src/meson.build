src = files([
    'main.cpp',
    'config.cpp',
    'runtime_policy.cpp',
    'policy_engine.cpp',
    'output_recognizer.cpp',
    'transport_truth.cpp',
    'openxr_timeline.cpp',
    'openxr_hooks.cpp',
    'audio_timeline.cpp',
    'audio_hooks.cpp',
    'input_arbiter.cpp',
    'hybrid_fusion.cpp',
    'fakenvapi.cpp',
    'fakexell.cpp',
    'streamline_capability.cpp',
    'low_latency.cpp',
    'low_latency_d3d.cpp',
    'low_latency_vk.cpp',
    'low_latency_tech/ll_antilag2.cpp',
    'low_latency_tech/ll_antilag_vk.cpp',
    'low_latency_tech/ll_vkd3d_antilag_vk.cpp',
    'low_latency_tech/ll_xell.cpp',
    'low_latency_tech/ll_latencyflex.cpp',
    'low_latency_tech/ll_vulkanflex.cpp',
    'vulkan_hooks.cpp',
    'vulkan_device_registry.cpp',
    'vulkan_capabilities.cpp',
    'vulkan_present_precision.cpp',
    'vulkan_queue_pressure.cpp',
