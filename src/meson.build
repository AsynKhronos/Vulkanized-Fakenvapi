fakenvapi_version_dep = declare_dependency(sources: fakenvapi_version)

shared_library(
    'nvapi' + target_suffix,
    src,
    rc,
    name_prefix: '',
    dependencies: [fakenvapi_version_dep, lib_dxgi, lib_detours],
    include_directories: [fakenvapi_headers, nvapi_headers, spdlog_headers, xell_headers, vulkan_headers, magic_enum_headers],
    install: true,
)
